{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crescent",
  "version": "0.1.22",
  "identifier": "com.crescent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crescent",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "shadow": true,
        "theme": "Dark",
        "additionalBrowserArgs": "--enable-features=msEdgeSubpixelFontRendering,CanvasOopif --high-dpi-support=1 --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
